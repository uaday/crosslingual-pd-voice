%% PIPELINE DIAGRAM — paste into Excalidraw
%% Excalidraw:  top-left menu  ->  "Mermaid to Excalidraw"  ->  paste  ->  Insert
%% Kept to plain flowchart syntax (no classDef / style), which is what the
%% importer converts reliably.

flowchart TD

    subgraph S1["1 - DATA: 4 corpora, 3 languages"]
        D1["mPower - English
        4,809 speakers
        sustained vowel /a/
        self-reported label"]
        D2["NeuroVoz - Spanish
        114 speakers
        vowel + speech"]
        D3["IPVS - Italian
        65 speakers
        vowel + speech"]
        D4["MDVR-KCL - English
        37 speakers
        speech only"]
    end

    subgraph S2["2 - PREPROCESSING: same for every corpus"]
        P1["load_audio
        in: 44.1 kHz file
        out: 16 kHz mono float32"]
        P2["remove non-speech
        vowel: trim_silence
        speech: Silero VAD"]
        P3["fixed window
        vowel: 2 s stable core
        speech: 5 s chunks, 50% overlap"]
        P4["normalise_amplitude
        every clip to -23 dBFS
        EBU R128"]
    end

    subgraph S3["3 - FROZEN ENCODER: never trained"]
        E1["XLS-R-300M
        315,438,720 weights
        FROZEN"]
        E2["hidden layer 15
        out: T x 1024, one frame per 20 ms"]
        E3["mean + std pooling
        out: 2048 numbers per recording"]
    end

    subgraph S4["4 - THE ONLY PART THAT LEARNS"]
        H1["MLP head
        2048 - 256 - 1
        525,313 weights = 0.17%"]
        H2["calibrator
        logit to probability"]
        H3["threshold
        chosen on mPower validation"]
    end

    subgraph S5["5 - LOCK, then evaluate"]
        L1["LOCKED
        weights + calibrator + threshold
        frozen before any test set is opened"]
        L2["average per SPEAKER
        not per recording"]
        L3["discrimination
        AUROC, AUPRC + 95% CI"]
        L4["calibration
        ECE, MCE, Brier"]
        L5["operating point
        sens, spec, sens at 90% spec"]
        L6["clinical utility
        net benefit, pt = 0.10"]
    end

    subgraph S6["6 - CONTROLS: does the result survive?"]
        C1["age matching
        5-year bins, equal PD/HC"]
        C2["age-only baseline
        1 feature, NO audio"]
        C3["embedding probes
        what else is in the 2048?"]
        C4["significance
        DeLong + paired bootstrap"]
    end

    D1 --> P1
    D2 --> P1
    D3 --> P1
    D4 --> P1
    P1 --> P2 --> P3 --> P4
    P4 --> E1 --> E2 --> E3

    E3 -->|"mPower only + PD/HC label"| H1
    H1 --> H2 --> H3 --> L1

    E3 -->|"NeuroVoz, IPVS, MDVR
    never seen in training"| L1

    L1 --> L2
    L2 --> L3
    L2 --> L4
    L2 --> L5
    L2 --> L6

    L2 --> C1
    L2 --> C2
    E3 --> C3
    L3 --> C4
